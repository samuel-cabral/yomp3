# Developer ID code signing + notarization
# Source this file (`source .env`) before running Scripts/build-app.sh and Scripts/package-dmg.sh
# for a signed and notarized build. Leave empty for ad-hoc signing (local dev).

# Full Developer ID Application identity, e.g.:
# export DEVELOPER_ID_APPLICATION="Developer ID Application: Samuel Cabral (XXXXXXXXXX)"
export DEVELOPER_ID_APPLICATION=""

# notarytool keychain profile name (created once via `xcrun notarytool store-credentials yomp3-notary`)
export NOTARY_PROFILE=""
